<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Pairing credentials and connection history must not leave the phone. -->
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
