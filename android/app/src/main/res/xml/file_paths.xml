<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only the updater shares files: the downloaded APK, handed to the
         installer. Scoping to those two directories (external preferred,
         cache fallback) keeps the provider from serving anything else the
         app can read, should a future getUriForFile name the wrong file. -->
    <external-files-path name="updates" path="updates/" />
    <cache-path name="updates-cache" path="updates/" />
</paths>