<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A same-named style in a qualified folder replaces the base one
         wholesale, so the bar items below have to be repeated here or API 31+
         falls back to the splash colour and the seam comes back. The splash
         window keeps its own background; only the bar above it changes. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/launch_background</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">@bool/status_bar_icons_dark</item>
    </style>
</resources>
