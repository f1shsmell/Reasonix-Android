{
  "name": "reasonix-mobile",
  "private": true,
  "version": "0.2.9",
  "type": "module",
  "description": "Reasonix For Android — an unofficial Android client for Reasonix Studio.",
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src --report-unused-disable-directives --max-warnings=25",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "manifest": "node scripts/latest-json.mjs",
    "fixtures": "node scripts/record-wire-fixtures.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/network": "^8.0.1",
    "@noble/curves": "^2.4.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
